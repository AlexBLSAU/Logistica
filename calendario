<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"><meta name="robots" content="noindex, nofollow"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>Calendario 2027</title></head><body>
<script type="application/json" id="estado">{"ro":false,"dias":22,"vac":[],"otr":[],"loc":[]}</script>
<script>(function(){
  var CSS = `
:root{
  --bg:#f4f6fb; --card:#ffffff; --ink:#1a1f36; --muted:#6b7285; --line:#dde2ee; --navy:#1e2761; --gold:#c9972b;
  --fest:#d64545; --wknd:#e3e6ee; --wknd-ink:#8a90a2; --vac:#2e9e5b; --otr:#3b4a8c; --chip:#eef1f8; --warn:#d64545;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#12151f; --card:#1b2030; --ink:#e8eaf2; --muted:#9aa1b5; --line:#2c3350; --navy:#a9b6ff; --gold:#e0b04a;
    --fest:#e06464; --wknd:#2a3045; --wknd-ink:#7c8399; --vac:#34b06a; --otr:#6c7fd8; --chip:#232a3f; --warn:#ff7b7b;
  }
}
:root[data-theme="dark"]{
  --bg:#12151f; --card:#1b2030; --ink:#e8eaf2; --muted:#9aa1b5; --line:#2c3350; --navy:#a9b6ff; --gold:#e0b04a;
  --fest:#e06464; --wknd:#2a3045; --wknd-ink:#7c8399; --vac:#34b06a; --otr:#6c7fd8; --chip:#232a3f; --warn:#ff7b7b;
}
html{ height:100%; scroll-padding-top:calc(env(safe-area-inset-top,0px) + 96px); }
*{ box-sizing:border-box; }
body{ margin:0; min-height:100%; background:var(--bg); color:var(--ink); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif; }
body::before{ content:""; position:fixed; inset:0 0 auto; height:env(safe-area-inset-top,0px); background:var(--card); z-index:10; }
.wrap{ max-width:1180px; margin:0 auto; padding:0 14px 40px; }
header.top{ position:sticky; top:env(safe-area-inset-top,0px); z-index:9; background:var(--card); border-bottom:1px solid var(--line); margin:0 -14px 16px; padding:12px 14px; }
h1{ margin:0; font-size:21px; color:var(--navy); letter-spacing:.2px; }
.sub{ margin:2px 0 0; font-size:12.5px; color:var(--muted); }
.bar{ display:flex; flex-wrap:wrap; gap:10px 18px; align-items:center; margin-top:10px; }
.stat{ display:flex; flex-direction:column; line-height:1.15; }
.stat b{ font-size:22px; color:var(--ink); }
.stat span{ font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.4px; }
.stat.left b{ color:var(--vac); } .stat.left.neg b{ color:var(--warn); }
.stat input{ width:64px; font-size:20px; font-weight:700; padding:2px 6px; border:1.5px solid var(--line); border-radius:8px; background:var(--card); color:var(--ink); }
.modes{ display:flex; gap:6px; margin-left:auto; }
.modes button{ border:1.5px solid var(--line); background:var(--card); color:var(--ink); border-radius:999px; padding:7px 14px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:7px; }
.modes button i{ width:11px; height:11px; border-radius:50%; display:inline-block; }
.modes button[data-m="vac"] i{ background:var(--vac); } .modes button[data-m="otr"] i{ background:var(--otr); }
.modes button.on{ border-color:var(--navy); box-shadow:0 0 0 2px var(--navy) inset; }
.legend{ display:flex; flex-wrap:wrap; gap:6px 14px; font-size:12px; color:var(--muted); margin:0 0 14px; }
.legend span{ display:flex; align-items:center; gap:6px; } .legend i{ width:13px; height:13px; border-radius:4px; display:inline-block; }
#meses{ display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:14px; }
.mes{ background:var(--card); border:1px solid var(--line); border-radius:14px; overflow:hidden; }
.mes h2{ margin:0; padding:8px 12px; font-size:14px; background:var(--navy); color:#fff; display:flex; justify-content:space-between; align-items:baseline; }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .mes h2{ color:#12151f; } }
:root[data-theme="dark"] .mes h2{ color:#12151f; }
.mes h2 small{ font-weight:600; font-size:11.5px; opacity:.95; }
.grid{ display:grid; grid-template-columns:repeat(7,1fr); gap:3px; padding:8px; }
.dow{ text-align:center; font-size:10.5px; font-weight:700; color:var(--muted); padding-bottom:2px; } .dow.dom{ color:var(--fest); }
.d{ height:34px; border:0; border-radius:8px; background:transparent; color:var(--ink); font-size:13px; font-family:inherit; display:flex; align-items:center; justify-content:center; padding:0; user-select:none; -webkit-user-select:none; }
button.d{ cursor:pointer; } button.d:hover{ outline:2px solid var(--line); }
.d.empty{ visibility:hidden; }
.d.wknd{ background:var(--wknd); color:var(--wknd-ink); cursor:default; }
.d.fest{ background:var(--fest); color:#fff; font-weight:700; cursor:help; }
.d.vac{ background:var(--vac); color:#fff; font-weight:700; }
.d.otr{ background:var(--otr); color:#fff; font-weight:700; }
.d.hoy{ box-shadow:0 0 0 2px var(--gold) inset; }
.panel{ background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px; margin-top:16px; }
.panel h3{ margin:0 0 8px; font-size:14px; color:var(--navy); }
.row{ display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
.row label{ font-size:12px; color:var(--muted); display:flex; flex-direction:column; gap:3px; }
input[type=date], input[type=text]{ font-size:14px; padding:7px 9px; border:1.5px solid var(--line); border-radius:8px; background:var(--card); color:var(--ink); font-family:inherit; }
.btn{ border:0; border-radius:8px; padding:9px 14px; font-size:13px; font-weight:700; cursor:pointer; background:var(--navy); color:#fff; font-family:inherit; }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .btn{ color:#12151f; } }
:root[data-theme="dark"] .btn{ color:#12151f; }
.btn.alt{ background:var(--chip); color:var(--ink); border:1.5px solid var(--line); }
.btn.danger{ background:transparent; color:var(--warn); border:1.5px solid var(--warn); }
.chips{ display:flex; flex-wrap:wrap; gap:6px; margin-top:6px; }
.chip{ background:var(--chip); border-radius:999px; padding:5px 11px; font-size:12.5px; display:flex; gap:6px; align-items:center; }
.chip b{ color:var(--fest); } .chip button{ border:0; background:transparent; color:var(--muted); cursor:pointer; font-size:15px; line-height:1; padding:0 0 0 2px; }
.note{ font-size:12px; color:var(--muted); margin:10px 0 0; }

body.ro .edit-only{ display:none !important; }
body.ro button.d{ cursor:default; } body.ro button.d:hover{ outline:none; }
.rom{ margin:8px 0 0; font-size:12.5px; color:var(--muted); background:var(--chip); border-radius:8px; padding:6px 10px; }
.rom[hidden]{ display:none; }
.stat input:disabled{ border-color:transparent; background:transparent; }
`;
  var BODY = `<div class="wrap">
  <header class="top">
    <h1>Calendario 2027 · Alejandro López</h1>
    <p class="sub">Azuqueca de Henares<span class="edit-only"> · Haz clic en un día para marcarlo (en ordenador también puedes arrastrar). Se guarda en este navegador.</span></p>
    <div class="bar">
      <div class="stat"><label for="dias" style="display:contents"><input id="dias" type="number" min="0" max="60" value="22" aria-label="Días de vacaciones al año"></label><span>Días al año</span></div>
      <div class="stat"><b id="plan">0</b><span>Planificadas</span></div>
      <div class="stat left" id="leftBox"><b id="quedan">22</b><span>Te quedan</span></div>
      <div class="stat"><b id="otros">0</b><span>Otros libres</span></div>
      <div class="modes edit-only" role="group" aria-label="Qué marcar">
        <button type="button" data-m="vac" class="on"><i></i>Vacaciones</button>
        <button type="button" data-m="otr"><i></i>Otros libres</button>
      </div>
    </div>
    <p class="rom" id="roMsg" hidden>Solo lectura: este es el calendario de Alejandro López.</p>
  </header>

  <div class="legend">
    <span><i style="background:var(--fest)"></i>Festivo</span>
    <span><i style="background:var(--wknd)"></i>Fin de semana</span>
    <span><i style="background:var(--vac)"></i>Vacaciones</span>
    <span><i style="background:var(--otr)"></i>Otros libres</span>
    <span><i style="box-shadow:0 0 0 2px var(--gold) inset"></i>Hoy</span>
  </div>

  <div id="meses"></div>

  <div class="panel edit-only">
    <h3>Marcar un rango de fechas</h3>
    <div class="row">
      <label>Desde<input id="rDesde" type="date" min="2027-01-01" max="2027-12-31"></label>
      <label>Hasta<input id="rHasta" type="date" min="2027-01-01" max="2027-12-31"></label>
      <button class="btn" id="rAdd" type="button">Marcar</button>
      <button class="btn alt" id="rDel" type="button">Quitar</button>
    </div>
    <p class="note" id="rMsg">Se marca con el tipo seleccionado arriba. Los fines de semana y festivos no se cuentan.</p>
  </div>

  <div class="panel">
    <h3>Festivos 2027</h3>
    <div class="chips" id="festList"></div>
    <div class="row edit-only" style="margin-top:12px">
      <label>Festivo local<input id="lFecha" type="date" min="2027-01-01" max="2027-12-31"></label>
      <label>Nombre<input id="lNombre" type="text" placeholder="Fiesta local" maxlength="40"></label>
      <button class="btn" id="lAdd" type="button">Añadir festivo local</button>
    </div>
    <p class="note">Falta el segundo festivo local de Azuqueca, todavía sin fijar. El 15 de mayo es provisional.</p>
  </div>

  <div class="panel">
    <button class="btn danger edit-only" id="reset" type="button">Borrar mis días marcados</button>
    <p class="note">Festivos regionales: Decreto 34/2026 de Castilla-La Mancha. Revisa los días de vacaciones al año con tu contrato.</p>
  </div>
</div>
`;
  var stEl = document.createElement('style'); stEl.textContent = CSS; document.head.appendChild(stEl);
  document.body.insertAdjacentHTML('afterbegin', BODY);

  var YEAR = 2027, DRAFT = 'cal2027_borrador';
  var MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  var MES3 = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  var DIAS3 = ['dom','lun','mar','mié','jue','vie','sáb'];
  var FEST = [
    ['2027-01-01','Año Nuevo'], ['2027-01-06','Epifanía del Señor'], ['2027-03-25','Jueves Santo'], ['2027-03-26','Viernes Santo'],
    ['2027-05-01','Fiesta del Trabajo'], ['2027-05-15','San Isidro (local, por confirmar)'], ['2027-05-27','Corpus Christi'],
    ['2027-05-31','Día de Castilla-La Mancha'], ['2027-10-12','Fiesta Nacional'], ['2027-11-01','Todos los Santos'],
    ['2027-12-06','Día de la Constitución'], ['2027-12-08','Inmaculada Concepción'], ['2027-12-25','Navidad']
  ];
  var $ = function(s){ return document.querySelector(s); };
  var mode = 'vac', canEdit = false, dirty = false;

  function norm(j){
    j = j || {};
    var d = Number(j.dias);
    return { ro: !!j.ro, dias: (j.dias === null || j.dias === undefined || !isFinite(d)) ? 22 : d, vac: new Set(j.vac || []), otr: new Set(j.otr || []), loc: Array.isArray(j.loc) ? j.loc : [] };
  }
  function readPublished(){ try{ return norm(JSON.parse(document.getElementById('estado').textContent)); }catch(e){ return norm({}); } }
  var state = readPublished();
  function toJson(){
    return JSON.stringify({ dias: state.dias, vac: Array.from(state.vac).sort(), otr: Array.from(state.otr).sort(), loc: state.loc }).replace(/</g, '\\u003c');
  }
  function setEdit(v){
    canEdit = v; document.body.classList.toggle('ro', !v);
    $('#roMsg').hidden = v; $('#dias').disabled = !v;
  }
  function markDirty(){ dirty = true; try{ localStorage.setItem(DRAFT, toJson()); }catch(e){} }
  function applyDraft(){
    try{
      var raw = localStorage.getItem(DRAFT);
      if(raw){ state = norm(JSON.parse(raw)); dirty = true; $('#dias').value = state.dias; render(); }
    }catch(e){}
  }
  function esc(t){ return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
  function pad(n){ return (n < 10 ? '0' : '') + n; }
  function iso(y, m, d){ return y + '-' + pad(m + 1) + '-' + pad(d); }
  function parse(s){ var p = s.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]); }
  function festMap(){
    var m = {};
    FEST.forEach(function(f){ m[f[0]] = f[1]; });
    state.loc.forEach(function(f){ m[f.d] = f.n; });
    return m;
  }
  function laborable(d, fm){ var w = parse(d).getDay(); return w !== 0 && w !== 6 && !fm[d]; }

  function render(){
    var fm = festMap(), now = new Date(), today = iso(now.getFullYear(), now.getMonth(), now.getDate());
    var html = '';
    for(var m = 0; m < 12; m++){
      var first = new Date(YEAR, m, 1), off = (first.getDay() + 6) % 7, n = new Date(YEAR, m + 1, 0).getDate(), cnt = 0, cells = '';
      for(var i = 0; i < off; i++) cells += '<span class="d empty"></span>';
      for(var d = 1; d <= n; d++){
        var k = iso(YEAR, m, d), w = new Date(YEAR, m, d).getDay(), cls = 'd', title = '', tag = 'button';
        if(fm[k]){ cls += ' fest'; title = fm[k]; tag = 'span'; }
        else if(w === 0 || w === 6){ cls += ' wknd'; tag = 'span'; }
        else if(state.vac.has(k)){ cls += ' vac'; cnt++; }
        else if(state.otr.has(k)){ cls += ' otr'; }
        if(k === today) cls += ' hoy';
        cells += '<' + tag + (tag === 'button' ? ' type="button" data-d="' + k + '"' : '') + ' class="' + cls + '"' + (title ? ' title="' + esc(title) + '" aria-label="' + d + ' de ' + MESES[m] + ': ' + esc(title) + '"' : '') + '>' + d + '</' + tag + '>';
      }
      html += '<section class="mes"><h2>' + MESES[m] + '<small>' + (cnt ? cnt + (cnt === 1 ? ' día' : ' días') : '') + '</small></h2><div class="grid">' +
        ['L','M','X','J','V','S','D'].map(function(x, j){ return '<div class="dow' + (j === 6 ? ' dom' : '') + '">' + x + '</div>'; }).join('') + cells + '</div></section>';
    }
    $('#meses').innerHTML = html;
    renderFest(fm); counters();
  }
  function renderFest(fm){
    var all = FEST.map(function(f){ return { d: f[0], n: f[1], loc: false }; }).concat(state.loc.map(function(f, i){ return { d: f.d, n: f.n, loc: true, i: i }; }));
    all.sort(function(a, b){ return a.d < b.d ? -1 : 1; });
    $('#festList').innerHTML = all.map(function(f){
      var dt = parse(f.d);
      return '<span class="chip"><b>' + DIAS3[dt.getDay()] + ' ' + dt.getDate() + ' ' + MES3[dt.getMonth()] + '</b> ' + esc(f.n) + (f.loc && canEdit ? '<button type="button" data-del="' + f.i + '" aria-label="Quitar">×</button>' : '') + '</span>';
    }).join('');
  }
  function counters(){
    var fm = festMap(), v = 0, o = 0;
    state.vac.forEach(function(d){ if(laborable(d, fm)) v++; });
    state.otr.forEach(function(d){ if(laborable(d, fm)) o++; });
    $('#plan').textContent = v; $('#otros').textContent = o;
    var left = state.dias - v; $('#quedan').textContent = left;
    $('#leftBox').className = 'stat left' + (left < 0 ? ' neg' : '');
  }
  function paintDay(d, add){
    var fm = festMap(); if(!laborable(d, fm)) return;
    var tgt = mode === 'vac' ? state.vac : state.otr, other = mode === 'vac' ? state.otr : state.vac;
    if(add){ tgt.add(d); other.delete(d); } else { tgt.delete(d); }
    var el = document.querySelector('[data-d="' + d + '"]');
    if(el){ el.className = 'd' + (state.vac.has(d) ? ' vac' : state.otr.has(d) ? ' otr' : '') + (el.classList.contains('hoy') ? ' hoy' : ''); }
    counters();
  }
  function refreshMonthCounts(){
    var secs = document.querySelectorAll('.mes'), fm = festMap();
    for(var m = 0; m < 12; m++){
      var c = 0; state.vac.forEach(function(d){ if(parse(d).getMonth() === m && laborable(d, fm)) c++; });
      secs[m].querySelector('small').textContent = c ? c + (c === 1 ? ' día' : ' días') : '';
    }
  }

  // Marcar con clic (táctil / teclado) o arrastrando (ratón)
  var dragging = false, dragAdd = true, ignoreClick = false, seen = {};
  var meses = $('#meses');
  meses.addEventListener('pointerdown', function(e){
    if(!canEdit || e.pointerType !== 'mouse' || e.button !== 0) return;
    var el = e.target.closest('[data-d]'); if(!el) return;
    var d = el.getAttribute('data-d'), tgt = mode === 'vac' ? state.vac : state.otr;
    dragging = true; ignoreClick = true; dragAdd = !tgt.has(d); seen = {}; seen[d] = 1; paintDay(d, dragAdd); e.preventDefault();
  });
  document.addEventListener('pointermove', function(e){
    if(!dragging) return;
    var el = document.elementFromPoint(e.clientX, e.clientY); el = el && el.closest ? el.closest('[data-d]') : null;
    if(!el) return; var d = el.getAttribute('data-d'); if(seen[d]) return; seen[d] = 1; paintDay(d, dragAdd);
  });
  document.addEventListener('pointerup', function(){ if(dragging){ dragging = false; markDirty(); refreshMonthCounts(); } });
  meses.addEventListener('click', function(e){
    var el = e.target.closest('[data-d]'); if(!el || !canEdit) return;
    if(ignoreClick){ ignoreClick = false; return; }
    var d = el.getAttribute('data-d'), tgt = mode === 'vac' ? state.vac : state.otr;
    paintDay(d, !tgt.has(d)); markDirty(); refreshMonthCounts();
  });

  document.querySelectorAll('.modes button').forEach(function(b){
    b.addEventListener('click', function(){ mode = b.getAttribute('data-m'); document.querySelectorAll('.modes button').forEach(function(x){ x.classList.toggle('on', x === b); }); });
  });
  $('#dias').addEventListener('input', function(){ if(!canEdit) return; var v = Number(this.value); state.dias = isFinite(v) ? v : 0; markDirty(); counters(); });

  function rango(add){
    if(!canEdit) return;
    var a = $('#rDesde').value, b = $('#rHasta').value, msg = $('#rMsg');
    if(!a || !b){ msg.textContent = 'Elige las dos fechas.'; return; }
    if(b < a){ msg.textContent = 'La fecha «Hasta» es anterior a «Desde».'; return; }
    var fm = festMap(), n = 0, d = parse(a), end = parse(b);
    while(d <= end){ var k = iso(d.getFullYear(), d.getMonth(), d.getDate()); if(k.indexOf(String(YEAR)) === 0 && laborable(k, fm)){ var tgt = mode === 'vac' ? state.vac : state.otr, other = mode === 'vac' ? state.otr : state.vac; if(add){ tgt.add(k); other.delete(k); } else { tgt.delete(k); } n++; } d.setDate(d.getDate() + 1); }
    markDirty(); render(); msg.textContent = (add ? 'Marcados ' : 'Quitados ') + n + (n === 1 ? ' día laborable.' : ' días laborables.');
  }
  $('#rAdd').addEventListener('click', function(){ rango(true); });
  $('#rDel').addEventListener('click', function(){ rango(false); });

  $('#lAdd').addEventListener('click', function(){
    if(!canEdit) return;
    var d = $('#lFecha').value, n = $('#lNombre').value.trim() || 'Festivo local';
    if(!d || d.indexOf(String(YEAR)) !== 0) return;
    state.loc = state.loc.filter(function(f){ return f.d !== d; }); state.loc.push({ d: d, n: n });
    $('#lFecha').value = ''; $('#lNombre').value = ''; markDirty(); render();
  });
  $('#festList').addEventListener('click', function(e){
    var b = e.target.closest('[data-del]'); if(!b || !canEdit) return;
    state.loc.splice(Number(b.getAttribute('data-del')), 1); markDirty(); render();
  });
  var armed = false, timer = null;
  $('#reset').addEventListener('click', function(){
    if(!canEdit) return;
    var b = this;
    if(!armed){ armed = true; b.textContent = 'Pulsa otra vez para confirmar'; timer = setTimeout(function(){ armed = false; b.textContent = 'Borrar mis días marcados'; }, 3500); return; }
    clearTimeout(timer); armed = false; b.textContent = 'Borrar mis días marcados'; state.vac = new Set(); state.otr = new Set(); markDirty(); render();
  });

  $('#dias').value = state.dias;
  render();

  // Si el archivo trae "ro": true se ve en solo lectura; si no, se edita y se guarda en este navegador.
  setEdit(!state.ro);
  if(!state.ro){ applyDraft(); }

})();</script>
</body></html>
